<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Mona Lisa Interativa</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      background-color: #f9f9f9;
      padding: 20px;
    }
    #container {
      position: relative;
      display: inline-block;
      margin-top: 20px;
    }
    #mona {
      max-width: 400px;
      border: 5px solid #ccc;
      border-radius: 10px;
      cursor: crosshair;
    }
    #zoom {
      position: absolute;
      border: 3px solid #333;
      border-radius: 10px;
      width: 150px;
      height: 150px;
      overflow: hidden;
      display: none;
      top: -160px;
      left: 0;
    }
    #zoom img {
      position: absolute;
      width: 400px;
      height: auto;
    }
    #info {
      margin-top: 20px;
      font-size: 18px;
    }
    button {
      margin: 10px;
      padding: 10px 15px;
      font-size: 16px;
      cursor: pointer;
    }
    #quiz {
      margin-top: 20px;
    }
  </style>
</head>
<body>

  <h1>🎨 Mona Lisa Interativa</h1>

  <div id="container">
    <img id="mona" src="https://upload.wikimedia.org/wikipedia/commons/6/6a/Mona_Lisa.jpg" alt="Mona Lisa">
    <div id="zoom"><img src="https://upload.wikimedia.org/wikipedia/commons/6/6a/Mona_Lisa.jpg"></div>
  </div>

  <div id="info">Passe o mouse sobre a imagem para ampliar detalhes.</div>

  <button onclick="mostrarCuriosidade()">Mostrar Curiosidade</button>

  <div id="quiz">
    <h2>Quiz sobre a Mona Lisa</h2>
    <p id="pergunta"></p>
    <button id="op1" onclick="responder(1)"></button>
    <button id="op2" onclick="responder(2)"></button>
    <button id="op3" onclick="responder(3)"></button>
  </div>

  <script>
    // ====== ZOOM INTERATIVO ======
    const mona = document.getElementById("mona");
    const zoom = document.getElementById("zoom");
    const zoomImg = zoom.querySelector("img");

    mona.addEventListener("mousemove", (e) => {
      const rect = mona.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      zoom.style.display = "block";
      zoom.style.left = `${x - 75}px`;
      zoom.style.top = `${y - 160}px`;

      zoomImg.style.left = `${-x * 2 + 75}px`;
      zoomImg.style.top = `${-y * 2 + 75}px`;
    });

    mona.addEventListener("mouseleave", () => {
      zoom.style.display = "none";
    });

    // ====== CURIOSIDADES ======
    const curiosidades = [
      "A Mona Lisa foi pintada entre 1503 e 1506.",
      "O sorriso da Mona Lisa muda dependendo do ângulo que você olha.",
      "O quadro está no Museu do Louvre, em Paris.",
      "A pintura mede 77 cm x 53 cm.",
      "Ela é uma das obras mais copiadas e estudadas do mundo!"
    ];

    const info = document.getElementById("info");

    function mostrarCuriosidade() {
      const indice = Math.floor(Math.random() * curiosidades.length);
      info.innerHTML = curiosidades[indice];
    }

    // ====== QUIZ ======
    const perguntas = [
      {
        pergunta: "Quem pintou a Mona Lisa?",
        opcoes: ["Leonardo da Vinci", "Michelangelo", "Raphael"],
        resposta: 1
      },
      {
        pergunta: "Onde a Mona Lisa está atualmente?",
        opcoes: ["Museu do Prado", "Museu do Louvre", "Museu Uffizi"],
        resposta: 2
      },
      {
        pergunta: "Qual o tamanho aproximado da pintura?",
        opcoes: ["77x53 cm", "100x70 cm", "50x40 cm"],
        resposta: 1
      }
    ];

    let indicePergunta = 0;

    function mostrarPergunta() {
      const q = perguntas[indicePergunta];
      document.getElementById("pergunta").innerText = q.pergunta;
      document.getElementById("op1").innerText = q.opcoes[0];
      document.getElementById("op2").innerText = q.opcoes[1];
      document.getElementById("op3").innerText = q.opcoes[2];
    }

    function responder(op) {
      const q = perguntas[indicePergunta];
      if(op === q.resposta){
        alert("✅ Correto!");
      } else {
        alert("❌ Errado! A resposta certa é: " + q.opcoes[q.resposta - 1]);
      }
      indicePergunta = (indicePergunta + 1) % perguntas.length;
      mostrarPergunta();
    }

    mostrarPergunta();
  </script>

</body>
</html>
